/* Converted from Kenny's VIA JSON (Crkbd, corbe32-11126_1_pk46.json) - CORRECTED ORDER Nov 2
 * VIA layers: 0=Base, 1=Fn1/Lower, 2=Fn2/Raise, 3=Tri-layer Adjust
 *
 * STOCK ORDER (Boardsource blecorne, foostan_corne_6col_layout) - this was wrong in v1:
 *  NOT half-by-half. Stock order is row-by-row, then thumbs at the end:
 *   Row 0: left row0 (6) + right row0 visual (6)
 *   Row 1: left row1 (6) + right row1 visual (6)
 *   Row 2: left row2 (6) + right row2 visual (6)
 *   Thumbs: left outer->inner (3) + right inner->outer (3)
 *  That is 12 + 12 + 12 + 6 = 42 bindings per layer.
 *
 * CHOSEN NODE RESTORED: the v1 file dropped the stock 'chosen { zmk,physical-layout }'
 * node, which is why ZMK Studio could not display a layout at all. It is back here.
 *
 * SPECIAL: FN_MO13=&mo 1, FN_MO23=&mo 2, conditional_layers 1+2->3, LT(3,SPC)=&lt 3 SPACE,
 * SFTENT=&mt LSHIFT ENTER, MACRO(9)=&none placeholder (typed string, not reproduced),
 * RGB_*=&none (board has no RGB; RGB_HUI broke build #5), numpad=KP_NUMBER_* (KP_7 broke build #6). */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "base_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp Q &kp W &kp E &kp R &kp T
                &kp Y &kp U &kp I &kp O &kp P &none
                /* row 1 left + right */
                &none &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &kp SQT &none
                /* row 2 left + right */
                &none &kp Z &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &none
                /* thumbs left outer->inner + right inner->outer */
                &mo 1 &kp LCTRL &lt 3 SPACE &mt LSHIFT ENTER &kp BSPC &mo 2
            >;
        };

        lower_layer {
            display-name = "lower_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp LC(LS(GRAVE)) &kp LC(P) &kp LC(LS(P)) &kp LC(LA(DELETE)) &none /* MACRO9 placeholder */
                &kp LA(F4) &none &none &none &kp LG(LS(S)) &none
                /* row 1 left + right */
                &none &kp TAB &kp ESCAPE &kp F2 &kp LA(TAB) &kp LC(TAB)
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_UP &none
                /* row 2 left + right */
                &none &kp LGUI &kp LALT &none &none &none
                &kp HOME &kp END &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &kp PG_DN &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp LCTRL &kp SPACE &kp ENTER &kp RSHIFT &trans
            >;
        };

        raise_layer {
            display-name = "raise_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
                &kp CARET &kp AMPS &kp ASTERISK &kp PLUS &kp EQUAL &none
                /* row 1 left + right */
                &none &kp TILDE &kp LT &kp LPAR &kp LBRC &kp LBKT
                &kp RBKT &kp RBRC &kp RPAR &kp GT &kp COLON &none
                /* row 2 left + right */
                &none &kp GRAVE &none &none &none &none
                &kp MINUS &kp UNDER &kp PIPE &kp BSLH &kp SEMI &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp DELETE &kp SPACE &kp ENTER &kp BSPC &trans
            >;
        };

        adjust_layer {
            display-name = "adjust_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &none &none
                &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9 &none &kp INSERT &none
                /* row 1 left + right */
                &none &none &none &none &none &kp LC(LS(EQUAL))
                &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &none &kp DELETE &none
                /* row 2 left + right */
                &none &none &none &none &none &kp LC(MINUS)
                &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3 &kp KP_DOT &none &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp ENTER &trans &kp BSPC &kp KP_NUMBER_0 &kp SPACE
            >;
        };

    };
};