/* Converted from Kenny's VIA JSON (Crkbd, corbe32-11126_1_pk46.json)
 * VIA layers: 0=Base, 1=Fn1/Lower, 2=Fn2/Raise, 3=Tri-layer Adjust
 * BINDING ORDER: standard ZMK Corne 42-position order:
 *   left main (visual), left thumbs inner->outer, right main (visual, Y first), right thumbs inner->outer
 * Outer column is &none on every layer (36-key layout on 42-key PCB).
 * VERIFY against your fork's stock keymap before flashing; if its thumb/right order differs,
 * reorder to match that file, or enter the layers in ZMK Studio from README.md instead.
 * KEEP your fork's existing headers, physical layout, and &studio_unlock combo if present.
 * SPECIAL: FN_MO13=&mo 1, FN_MO23=&mo 2, conditional_layers 1+2->3, LT(3,SPC)=&lt 3 SPACE,
 * SFTENT=&mt LSHIFT ENTER, MACRO(9)=&none placeholder (typed string, not reproduced),
 * RGB_*=&rgb_ug ... (replace with &none if no RGB / build fails), media=C_VOL_* */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "base_layer";
            bindings = <
                /* left main */
                &none &kp Q &kp W &kp E &kp R &kp T
                &none &kp A &kp S &kp D &kp F &kp G
                &none &kp Z &kp X &kp C &kp V &kp B
                /* left thumbs inner->outer */
                &lt 3 SPACE &kp LCTRL &mo 1
                /* right main */
                &kp Y &kp U &kp I &kp O &kp P &none
                &kp H &kp J &kp K &kp L &kp SQT &none
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &none
                /* right thumbs inner->outer */
                &mt LSHIFT ENTER &kp BSPC &mo 2
            >;
        };

        lower_layer {
            display-name = "lower_layer";
            bindings = <
                /* left main */
                &none &kp LC(LS(GRAVE)) &kp LC(P) &kp LC(LS(P)) &kp LC(LA(DELETE)) &none /* MACRO9 placeholder */
                &none &kp TAB &kp ESCAPE &kp F2 &kp LA(TAB) &kp LC(TAB)
                &none &kp LGUI &kp LALT &none &none &none
                /* left thumbs inner->outer */
                &kp SPACE &kp LCTRL &trans
                /* right main */
                &kp LA(F4) &none &none &none &kp LG(LS(S)) &none
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_UP &none
                &kp HOME &kp END &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &kp PG_DN &none
                /* right thumbs inner->outer */
                &kp ENTER &kp RSHIFT &trans
            >;
        };

        raise_layer {
            display-name = "raise_layer";
            bindings = <
                /* left main */
                &none &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
                &none &kp TILDE &kp LT &kp LPAR &kp LBRC &kp LBKT
                &none &kp GRAVE &none &none &none &none
                /* left thumbs inner->outer */
                &kp SPACE &kp DELETE &trans
                /* right main */
                &kp CARET &kp AMPS &kp ASTERISK &kp PLUS &kp EQUAL &none
                &kp RBKT &kp RBRC &kp RPAR &kp GT &kp COLON &none
                &kp MINUS &kp UNDER &kp PIPE &kp BSLH &kp SEMI &none
                /* right thumbs inner->outer */
                &kp ENTER &kp BSPC &trans
            >;
        };

        adjust_layer {
            display-name = "adjust_layer";
            bindings = <
                /* left main */
                &none &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &none &none
                &none &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_VAI &rgb_ug RGB_TOG &kp LC(LS(EQUAL))
                &none &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_VAD &rgb_ug RGB_MOD &kp LC(MINUS)
                /* left thumbs inner->outer */
                &trans &kp ENTER &trans
                /* right main */
                &kp KP_7 &kp KP_8 &kp KP_9 &none &kp INSERT &none
                &kp KP_4 &kp KP_5 &kp KP_6 &none &kp DELETE &none
                &kp KP_1 &kp KP_2 &kp KP_3 &kp KP_DOT &none &none
                /* right thumbs inner->outer */
                &kp BSPC &kp KP_0 &kp SPACE
            >;
        };

    };
};