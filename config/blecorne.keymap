/* Converted from Kenny's VIA JSON (Crkbd, corbe32-11126_1_pk46.json) - CORRECTED ORDER Nov 2
 * VIA layers: 0=Base, 1=Fn1/Lower, 2=Fn2/Raise, 3=Tri-layer Adjust
 *
 * STOCK ORDER (Boardsource blecorne, foostan_corne_6col_layout) - this was wrong in v1:
 *  NOT half-by-half. Stock order is row-by-row, then thumbs at the end:
 *   Row 0: left row0 (6) + right row0 visual (6)
 *   Row 1: left row1 (6) + right row1 visual (6)
 *   Row 2: left row2 (6) + right row2 visual (6)
 *   Thumbs: left outer->inner (3) + right inner->outer (3)
 *  That is 12 + 12 + 12 + 6 = 42 bindings per layer.
 *
 * CHOSEN NODE RESTORED: the v1 file dropped the stock 'chosen { zmk,physical-layout }'
 * node, which is why ZMK Studio could not display a layout at all. It is back here.
 *
 * SPECIAL: FN_MO13=&mo 1, FN_MO23=&mo 2, NO conditional_layers (user decision Nov 2).
 * Layer 3 is a NORMAL layer now. Left inner thumb = &lt 3 SPACE (tap Space, hold Layer 3).
 * Trade-off: Fn1+Fn2 together will NO LONGER give Adjust - Layer 2 wins over Layer 1,
 * so you get Raise keys, not Adjust. Adjust is now only via the left inner thumb hold.
 * SFTENT=&mt LSHIFT ENTER, MACRO(9)=string macro defined in behaviors node (Layer 1, next to Ctrl+Alt+Del),
 * Layer 1 bottom-left innermost keys = Ctrl+Shift+PgUp / Ctrl+Shift+PgDn, RGB=&none, numpad=KP_NUMBER_*
 * Layer 3 (Adjust) row 1: BT_SEL 0-3 on left, BT_CLR on left row 2 (first usable key)
 * Layer 3 row 0 left, first blank after Mute = &studio_unlock (press while Studio is connected to unlock editing)
 * Layer 3 row 0 left last = &out OUT_TOG (toggle USB/BT output, for Studio over USB)
 * Layer 3 row 0 right blank after KP9 = &bootloader (enter UF2 mode without double-tap reset)
 * Layer 3 row 2 left, blank after BT_CLR = &bt BT_SEL 4 (5th BT profile) */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    behaviors {
        macro9: macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1 &kp N1 &kp N9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "base_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp Q &kp W &kp E &kp R &kp T
                &kp Y &kp U &kp I &kp O &kp P &none
                /* row 1 left + right */
                &none &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &kp SQT &none
                /* row 2 left + right */
                &none &kp Z &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp FSLH /* base last button, 3rd row right: slash, Shift+/ = ? */
                /* thumbs left outer->inner + right inner->outer */
                &mo 1 &kp LCTRL &lt 3 SPACE &mt LSHIFT ENTER &kp BSPC &mo 2
            >;
        };

        lower_layer {
            display-name = "lower_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp LC(LS(GRAVE)) &kp LC(P) &kp LC(LS(P)) &kp LC(LA(DELETE)) &macro9 /* Layer 1 string macro, next to Ctrl+Alt+Del */
                &kp LA(F4) &none &none &none &kp LG(LS(S)) &none
                /* row 1 left + right */
                &none &kp TAB &kp ESCAPE &kp F2 &kp LA(TAB) &kp LC(TAB)
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_UP &none
                /* row 2 left + right */
                &none &kp LGUI &kp LALT &none &kp LC(LS(PG_UP)) &kp LC(LS(PG_DN))
                &kp HOME &kp END &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &kp PG_DN &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp LCTRL &kp SPACE &kp ENTER &kp RSHIFT &trans
            >;
        };

        raise_layer {
            display-name = "raise_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
                &kp CARET &kp AMPS &kp ASTERISK &kp PLUS &kp EQUAL &none
                /* row 1 left + right */
                &none &kp TILDE &kp LT &kp LPAR &kp LBRC &kp LBKT
                &kp RBKT &kp RBRC &kp RPAR &kp GT &kp COLON &none
                /* row 2 left + right */
                &none &kp GRAVE &none &none &none &none
                &kp MINUS &kp UNDER &kp PIPE &kp BSLH &kp SEMI &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp DELETE &kp SPACE &kp ENTER &kp BSPC &trans
            >;
        };

        adjust_layer {
            display-name = "adjust_layer";
            bindings = <
                /* row 0 left + right */
                &none &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &studio_unlock &out OUT_TOG
                &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9 &bootloader &kp INSERT &none
                /* row 1 left + right */
                &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp LC(LS(EQUAL))
                &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &none &kp DELETE &none
                /* row 2 left + right */
                &none &bt BT_CLR &bt BT_SEL 4 &none &none &kp LC(MINUS)
                &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3 &kp KP_DOT &none &none
                /* thumbs left outer->inner + right inner->outer */
                &trans &kp ENTER &trans &kp BSPC &kp KP_NUMBER_0 &kp SPACE
            >;
        };

    };
};